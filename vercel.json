{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}